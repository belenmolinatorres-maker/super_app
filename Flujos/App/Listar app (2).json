        "query": "SELECT\n    a.id_app,\n    a.catalogo,\n    a.titulo,\n    a.descripcion,\n    c.nombre,\n    c.imagen,\n    COALESCE(a.direccion_enlace, c.direccion_enlace) AS direccion_enlace\nFROM app a\nLEFT JOIN catalogo c ON c.id_catalogo = a.catalogo\nWHERE a.usuario = {{ $json.payload.id_usuario }}\nAND a.fecha_eliminacion IS NULL;",
