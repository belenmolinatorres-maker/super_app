    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Restablecer Contraseña | Súper App</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-white min-h-screen flex items-center justify-center p-4 relative overflow-hidden\">\n\n    <div class=\"fixed inset-0 flex items-center justify-center opacity-[0.05] pointer-events-none z-0\">\n        <img src=\"https://ideasypruebas2.es/cursos/IFCT0211/Belen/logo_gestion.png\" alt=\"Watermark\" class=\"w-[500px] grayscale\">\n    </div>\n\n    <div class=\"relative z-10 w-full max-w-md bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden\">\n        <div class=\"p-8\">\n            <div class=\"text-center mb-8\">\n                <h2 class=\"text-2xl font-extrabold text-slate-900 tracking-tight\">Nueva Contraseña</h2>\n                <p class=\"text-slate-500 text-sm mt-2\">Crea una clave segura para recuperar tu acceso</p>\n            </div>\n\n            <div id=\"alertContainer\" class=\"hidden mb-6 p-4 rounded-xl border flex items-center gap-3 text-sm\">\n                <i id=\"alertIcon\" class=\"fas\"></i>\n                <p id=\"alertMessage\" class=\"font-medium\"></p>\n            </div>\n\n            <form id=\"resetForm\" class=\"space-y-6\">\n                <div>\n                    <label for=\"nueva_contraseya\" class=\"block text-sm font-semibold text-slate-700 mb-2\">Nueva Contraseña</label>\n                    <div class=\"relative\">\n                        <span class=\"absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400\">\n                            <i class=\"fas fa-lock\"></i>\n                        </span>\n                        <input type=\"password\" id=\"nueva_contraseya\" name=\"nueva_contraseya\" required\n                            class=\"block w-full pl-11 pr-4 py-3.5 border border-slate-200 rounded-2xl bg-slate-50 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm\"\n                            placeholder=\"Mínimo 6 caracteres\">\n                    </div>\n                </div>\n\n                <div>\n                    <label for=\"confirmar_contraseya\" class=\"block text-sm font-semibold text-slate-700 mb-2\">Confirmar Contraseña</label>\n                    <div class=\"relative\">\n                        <span class=\"absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400\">\n                            <i class=\"fas fa-shield-alt\"></i>\n                        </span>\n                        <input type=\"password\" id=\"confirmar_contraseya\" name=\"confirmar_contraseya\" required\n                            class=\"block w-full pl-11 pr-4 py-3.5 border border-slate-200 rounded-2xl bg-slate-50 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm\"\n                            placeholder=\"Repite tu contraseña\">\n                    </div>\n                </div>\n\n                <button type=\"submit\" id=\"submitBtn\"\n                    class=\"w-full flex justify-center py-4 px-4 border border-transparent rounded-2xl shadow-lg text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 transform hover:scale-[1.02] active:scale-[0.98]\">\n                    <span id=\"btnText\">Actualizar Contraseña</span>\n                    <span id=\"btnLoader\" class=\"hidden\">\n                        <i class=\"fas fa-circle-notch animate-spin\"></i>\n                    </span>\n                </button>\n            </form>\n        </div>\n\n        <div class=\"bg-slate-50 px-8 py-4 text-center border-t border-slate-100\">\n            <p class=\"text-[10px] text-slate-400 uppercase tracking-[0.2em] font-bold\">\n                © 2026 Gestión de Sistemas • Todos los derechos reservados\n            </p>\n        </div>\n    </div>\n\n    <div id=\"statusModal\" class=\"hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm\">\n        <div class=\"bg-white rounded-3xl shadow-2xl p-8 max-w-sm w-full text-center border border-slate-100\">\n            <div class=\"w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4\">\n                <i class=\"fas fa-check text-2xl\"></i>\n            </div>\n            <h3 class=\"text-xl font-bold text-slate-900 mb-2\">¡Todo listo!</h3>\n            <p class=\"text-slate-500 text-sm mb-6\">Tu contraseña ha sido actualizada correctamente. Serás redirigido al acceso en unos segundos.</p>\n            <button onclick=\"window.close()\" class=\"w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl transition-all text-sm shadow-xl transform hover:scale-[1.02] active:scale-[0.98]\">\n                Cerrar\n            </button>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function () {\n            var urlParams = new URLSearchParams(window.location.search);\n            var userId = urlParams.get('id');\n\n            if (!userId || userId.trim() === '') {\n                document.getElementById('alertContainer').classList.remove('hidden');\n                alertMessage.textContent = 'Enlace inválido o caducado. Solicita un nuevo restablecimiento.';\n                document.getElementById('resetForm').classList.add('hidden');\n                return;\n            }\n\n            var resetForm = document.getElementById('resetForm');\n            var alertContainer = document.getElementById('alertContainer');\n            var alertMessage = document.getElementById('alertMessage');\n            var alertIcon = document.getElementById('alertIcon');\n            var submitBtn = document.getElementById('submitBtn');\n            var btnLoader = document.getElementById('btnLoader');\n            var btnText = document.getElementById('btnText');\n            var statusModal = document.getElementById('statusModal');\n\n            resetForm.addEventListener('submit', async function (e) {\n                e.preventDefault();\n                hideAlert();\n\n                var nuevaContraseya = document.getElementById('nueva_contraseya').value;\n                var confirmarContraseya = document.getElementById('confirmar_contraseya').value;\n\n                if (nuevaContraseya.length < 6) {\n                    showAlert('La contraseña debe tener al menos 6 caracteres.', 'error');\n                    return;\n                }\n                if (nuevaContraseya !== confirmarContraseya) {\n                    showAlert('Las contraseñas no coinciden.', 'error');\n                    return;\n                }\n\n                setLoading(true);\n\n                try {\n                    var response = await fetch('https://n8n.misappsfantasticas.cloud/webhook/resetear', {\n                        method: 'POST',\n                        headers: { 'Content-Type': 'application/json' },\n                        body: JSON.stringify({\n                            id_usuario: userId,\n                            contraseya: nuevaContraseya\n                        })\n                    });\n\n                    if (!response.ok) {\n                        throw new Error('Error en la comunicación con el servidor');\n                    }\n\n                    var rawData = await response.json();\n                    var data = Array.isArray(rawData) ? rawData[0] : rawData;\n\n                    if (data.codigo === 1 || data.codigo === '1') {\n                        if (statusModal) {\n                            statusModal.classList.remove('hidden');\n                        } else {\n                            showAlert('¡Contraseña actualizada! Redirigiendo...', 'success');\n                        }\n                        // No redirigimos — el dominio del sitio está en mantenimiento\n                    } else {\n                        showAlert(data.mensaje || 'Error al actualizar la contraseña.', 'error');\n                    }\n\n                } catch (error) {\n                    console.error('Fetch Error:', error);\n                    showAlert('No se pudo conectar con el servidor. Verifica tu conexión.', 'error');\n                } finally {\n                    setLoading(false);\n                }\n            });\n\n            function showAlert(msg, type) {\n                if (!alertContainer) return;\n                alertMessage.textContent = msg;\n                alertContainer.classList.remove('hidden', 'bg-red-50', 'border-red-200', 'text-red-700', 'bg-green-50', 'border-green-200', 'text-green-700');\n                if (type === 'error') {\n                    alertContainer.classList.add('bg-red-50', 'border-red-200', 'text-red-700');\n                    if (alertIcon) alertIcon.className = 'fas fa-exclamation-circle text-red-500';\n                } else {\n                    alertContainer.classList.add('bg-green-50', 'border-green-200', 'text-green-700');\n                    if (alertIcon) alertIcon.className = 'fas fa-check-circle text-green-500';\n                }\n            }\n\n            function hideAlert() {\n                if (alertContainer) alertContainer.classList.add('hidden');\n            }\n\n            function setLoading(isLoading) {\n                if (!submitBtn) return;\n                submitBtn.disabled = isLoading;\n                if (isLoading) {\n                    if (btnLoader) btnLoader.classList.remove('hidden');\n                    if (btnText) btnText.classList.add('hidden');\n                    submitBtn.classList.add('opacity-75', 'cursor-not-allowed');\n                } else {\n                    if (btnLoader) btnLoader.classList.add('hidden');\n                    if (btnText) btnText.classList.remove('hidden');\n                    submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');\n                }\n            }\n        });\n    </script>\n</body>\n</html>\n",
        "options": {
          "responseHeaders": {
